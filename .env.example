REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REST_APP_PORT=8081

# Bearer token required on all key endpoints. If empty, the API is UNAUTHENTICATED.
REDIS_REST_API_TOKEN=

# Maximum request body size in bytes (default 1048576 = 1 MiB).
REDIS_REST_MAX_BODY_BYTES=1048576

# Deprecated unprefixed names (APP_PORT, API_TOKEN, MAX_BODY_BYTES) are still
# read as a fallback, but the REDIS_REST_-prefixed names above avoid collisions
# when this file is merged into a larger .env with other services.
